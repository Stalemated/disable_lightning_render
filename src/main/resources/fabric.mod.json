{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "${description}",
    "authors": [
        "${author}"
    ],
    "contact": {
        "sources": "${sources}",
        "issues": "${sources}/issues"
    },
    "license": "MIT",
    "icon": "assets/${id}/icon.png",
    "environment": "${environment}",
    "entrypoints": {
        "client": [
            "com.stalemated.dlr.DisableLightningRender"
        ]
    },
    "mixins": [
        "${id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "s_lib": "*"
    }
}
